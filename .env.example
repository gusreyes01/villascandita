# Openpay — obtén tus credenciales en https://dashboard.openpay.mx
# En sandbox usa las credenciales de prueba de Openpay

# Merchant ID (aparece en el dashboard de Openpay)
NEXT_PUBLIC_OPENPAY_MERCHANT_ID=mm1hu3ffla1omcctovon

# Merchant ID para el backend (mismo valor que el anterior)
OPENPAY_MERCHANT_ID=mm1hu3ffla1omcctovon

# Public API Key (para el frontend — tokenización)
NEXT_PUBLIC_OPENPAY_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx

# Private API Key (para el backend — cobros con tarjeta, SPEI y Paynet)
OPENPAY_PRIVATE_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Modo sandbox: "true" para pruebas, "false" para producción
NEXT_PUBLIC_OPENPAY_SANDBOX=true

# URL base validada por el servidor (HTTPS en produccion)
APP_BASE_URL=http://localhost:3000

# Secreto aleatorio de al menos 32 caracteres para vincular la verificacion 3D Secure
PAYMENT_SIGNING_SECRET=replace-with-at-least-32-random-characters
